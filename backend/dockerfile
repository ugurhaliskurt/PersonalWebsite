# Use an Ubuntu-based image for flexibility
FROM ubuntu:22.04 AS builder

# Install dependencies
RUN apt-get update && apt-get install -y \
    g++ \
    cmake \
    python3 \
    python3-pip \
    libcurl4-openssl-dev \
    libpq-dev \
    libevent-dev \
    libpqxx-dev \
    git \
    meson \
    ninja-build \
    nlohmann-json3-dev \
    gdb \
    && apt-get clean

# Install GoogleTest from source
RUN git clone https://github.com/google/googletest.git /googletest \
    && cd /googletest \
    && cmake . \
    && make \
    && make install \
    && cd / \
    && rm -rf /googletest

# Install Pistache from source using Meson
RUN git clone https://github.com/oktal/pistache.git /pistache \
    && cd /pistache \
    && meson setup builddir \
    && ninja -C builddir \
    && ninja -C builddir install \
    && cd / \
    && rm -rf /pistache


# Install PostgreSQL client libraries and headers for C++
RUN apt-get install -y postgresql-client

# Copy source code
WORKDIR /app
COPY . .
# Build your C++ project (adjust this depending on your structure)
RUN mkdir -p build && cd build && cmake .. && make -j$(nproc)
# ---------- Stage 2: Runtime ----------
FROM ubuntu:22.04 AS runtime

# Install only runtime libraries
RUN apt-get update && apt-get install -y \
    libcurl4 \
    libpq5 \
    libevent-dev \
    libpqxx-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy built binary from builder
WORKDIR /app
COPY --from=builder /app/build/service/BasicService .

# Copy Pistache runtime library (modify path according to find command result)
COPY --from=builder /usr/local/lib/x86_64-linux-gnu/libpistache.so* /usr/local/lib/

# Make sure dynamic linker can find Pistache
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

# Expose service port
EXPOSE 9080

# Run the service
CMD ["./BasicService"]